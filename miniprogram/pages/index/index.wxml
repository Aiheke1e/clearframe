<!--index.wxml-->
<view class="page">
  <view class="title">X视频下载</view>
  <view class="sub">支持抖音、快手视频去水印</view>

  <textarea
    class="input"
    maxlength="-1"
    auto-height
    placeholder="粘贴链接"
    value="{{input}}"
    bindinput="onInput"
  />

  <view class="actions">
    <button class="btn ghost" bindtap="onPaste" loading="{{pasting}}">粘贴</button>
    <button class="btn primary" bindtap="onParse" loading="{{loading}}" disabled="{{loading}}">解析</button>
  </view>

  <view wx:if="{{showXTip}}" class="x-tip">X 视频需要翻墙才能获取</view>
  <view wx:if="{{status}}" class="status {{statusType}}">{{status}}</view>

  <block wx:if="{{items.length}}">
    <view class="result-bar">
      <text class="count">{{items.length}} 个文件</text>
      <text wx:if="{{items.length > 1}}" class="save-all" bindtap="onSaveAll">全部保存</text>
    </view>

    <view class="card" wx:for="{{items}}" wx:key="index">
      <view class="media-box">
        <video
          wx:if="{{item.kind === 'video'}}"
          class="media"
          src="{{item.previewUrl}}"
          controls
          object-fit="contain"
          show-center-play-btn
          enable-play-gesture
          show-mute-btn
        />
        <image
          wx:else
          class="media"
          src="{{item.previewUrl}}"
          mode="aspectFit"
          lazy-load
        />
      </view>
      <view class="card-foot">
        <text class="name">{{item.kind === 'video' ? '视频' : '图片'}}{{items.length > 1 ? ' ' + (index + 1) : ''}}</text>
        <view
          class="save"
          data-index="{{index}}"
          bindtap="onSave"
        >{{savingIndex === index || savingAll ? '…' : '保存'}}</view>
      </view>
    </view>
  </block>
</view>
