/**index.wxss**/
page {
  background: #0f1419;
  color: #e7e9ea;
  min-height: 100%;
}

.page {
  min-height: 100%;
  padding: 24rpx 28rpx 80rpx;
  box-sizing: border-box;
  background: #0f1419;
}

.title {
  font-size: 40rpx;
  font-weight: 700;
  margin-bottom: 8rpx;
}

.sub {
  font-size: 24rpx;
  color: #8b98a5;
  margin-bottom: 24rpx;
  line-height: 1.4;
}

.input {
  width: 100%;
  min-height: 140rpx;
  box-sizing: border-box;
  background: #1a222c;
  border: 1rpx solid #2f3b47;
  border-radius: 20rpx;
  padding: 22rpx;
  color: #e7e9ea;
  font-size: 28rpx;
  line-height: 1.45;
}

.actions {
  display: flex;
  gap: 16rpx;
  margin-top: 20rpx;
}

.btn {
  flex: 1;
  border-radius: 16rpx !important;
  font-weight: 600;
  font-size: 30rpx;
  line-height: 2.2;
  margin: 0;
  padding: 0;
}

.btn::after {
  border: none;
}

.ghost {
  background: #283340 !important;
  color: #e7e9ea !important;
}

.primary {
  background: #1d9bf0 !important;
  color: #fff !important;
}

.x-tip {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #f7b955;
  line-height: 1.4;
}

.status {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #8b98a5;
  line-height: 1.4;
}

.status.ok {
  color: #00ba7c;
}

.status.err {
  color: #f4212e;
}

.result-bar {
  margin-top: 28rpx;
  margin-bottom: 4rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.count {
  color: #8b98a5;
  font-size: 24rpx;
}

.save-all {
  color: #1d9bf0;
  font-size: 26rpx;
  font-weight: 600;
  padding: 8rpx 0;
}

.card {
  margin-top: 16rpx;
  background: #1a222c;
  border-radius: 20rpx;
  overflow: hidden;
}

.media-box {
  width: 100%;
  height: 400rpx;
  background: #000;
  overflow: hidden;
  position: relative;
}

.media {
  width: 100%;
  height: 100%;
  display: block;
  background: #000;
  vertical-align: top;
}

.card-foot {
  padding: 18rpx 20rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #1a222c;
}

.name {
  font-size: 28rpx;
  color: #e7e9ea;
}

.save {
  background: #1d9bf0;
  color: #fff;
  border-radius: 12rpx;
  font-weight: 600;
  font-size: 26rpx;
  padding: 12rpx 28rpx;
  line-height: 1;
}
