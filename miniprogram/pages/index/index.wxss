.page {
  padding: 40rpx 36rpx 96rpx;
  box-sizing: border-box;
}

.hero {
  padding: 28rpx 8rpx 36rpx;
}

.title {
  font-size: 52rpx;
  font-weight: 700;
  color: #24375d;
  letter-spacing: 2rpx;
  line-height: 1.25;
}

.subtitle {
  margin-top: 16rpx;
  font-size: 26rpx;
  color: #8b95a8;
  line-height: 1.55;
}

.input-card {
  min-height: 400rpx;
  padding: 40rpx 36rpx;
}

.link-input {
  width: 100%;
  min-height: 320rpx;
  font-size: 30rpx;
  line-height: 1.5;
  color: #2b3a55;
  background: transparent;
}

.placeholder {
  color: #a7b0c0;
}

.actions {
  display: flex;
  gap: 32rpx;
  margin-top: 48rpx;
}

.btn {
  flex: 1;
  margin: 0;
  height: 92rpx;
  line-height: 92rpx;
  font-size: 32rpx;
  font-weight: 600;
  border: none;
  padding: 0;
}

.btn::after {
  border: none;
}

.btn-clear {
  color: #2f4b78;
}

.btn-parse {
  color: #1f9d55;
}

.btn-hover {
  opacity: 0.86;
  transform: scale(0.985);
}

.disclaimer {
  margin-top: 44rpx;
  text-align: center;
  font-size: 24rpx;
  color: #9aa3b5;
}

.status {
  margin-top: 24rpx;
  text-align: center;
  font-size: 26rpx;
}

.status .ok {
  color: #1f9d55;
}

.status .err {
  color: #d64545;
}

.status .info {
  color: #6b778c;
}

.result {
  margin-top: 36rpx;
}

.result-head {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 8rpx;
}

.platform-tag {
  flex-shrink: 0;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  background: #dfe8f8;
  color: #2f4b78;
  font-size: 22rpx;
  font-weight: 600;
}

.result-title {
  font-size: 28rpx;
  color: #2b3a55;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.result-author {
  margin-bottom: 20rpx;
  font-size: 24rpx;
  color: #8b95a8;
}

.media-card {
  overflow: hidden;
  margin-bottom: 24rpx;
  border-radius: 22rpx;
}

.preview {
  width: 100%;
  height: 420rpx;
  background: #111827;
  display: block;
}

.media-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 24rpx;
}

.tag {
  font-size: 24rpx;
  color: #8b95a8;
}

.save-btn {
  margin: 0;
  background: #1f9d55 !important;
  color: #fff !important;
  border-radius: 999rpx;
  font-weight: 600;
}

.save-btn::after {
  border: none;
}

.features {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 64rpx;
  padding: 0 8rpx;
}

.feat {
  width: 22%;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.feat-icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.feat-mark {
  font-size: 36rpx;
  font-weight: 700;
}

.mark-red {
  color: #e25555;
  text-decoration: line-through;
}

.mark-blue {
  color: #3b82f6;
}

.mark-green {
  color: #1f9d55;
}

.feat-label {
  margin-top: 24rpx;
  font-size: 22rpx;
  color: #6b778c;
  text-align: center;
}

.toolbar { display: flex; gap: 24rpx; margin: 24rpx 0 28rpx; }
.toolbar-btn { flex: 1; margin: 0; padding: 20rpx 12rpx; font-size: 28rpx; line-height: 1.4; color: #24375d; border: none; }
.toolbar-btn::after { border: none; }
.grid { display: flex; flex-wrap: wrap; gap: 24rpx; }
.tile { position: relative; width: calc(50% - 12rpx); height: 436rpx; border-radius: 32rpx; overflow: hidden; background: #111827; box-shadow: 6px 6px 14px #d5dae3, -6px -6px 14px #ffffff; }
.tile.selected { outline: 6rpx solid #2a62d6; outline-offset: 0; }
.grid-preview { display: block; width: 100%; height: 100%; }
.badge { position: absolute; top: 16rpx; left: 16rpx; padding: 6rpx 16rpx; border-radius: 999rpx; background: rgba(0,0,0,.62); color: #fff; font-size: 22rpx; }
.selection-mark { position: absolute; top: 16rpx; right: 16rpx; width: 52rpx; height: 52rpx; border-radius: 50%; background: rgba(255,255,255,.92); text-align: center; line-height: 52rpx; font-size: 32rpx; color: transparent; }
.selected .selection-mark { color: #fff; background: #2a62d6; }
.usage { margin-top: 52rpx; text-align: center; font-size: 22rpx; color: #8b95a8; }
.preview-hint { margin: 0 0 24rpx; color: #8b95a8; font-size: 24rpx; }
.video-placeholder { display: flex; align-items: center; justify-content: center; width: 100%; height: 100%; color: #a7b0c0; font-size: 24rpx; padding-top: 100rpx; box-sizing: border-box; }
.play-mark { position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%); width: 88rpx; height: 88rpx; line-height: 88rpx; text-align: center; border-radius: 50%; background: rgba(0,0,0,.5); color: #fff; font-size: 36rpx; }
.transfer-card { margin-top: 28rpx; padding: 28rpx; border-radius: 24rpx; }
.transfer-heading { display: flex; justify-content: space-between; gap: 16rpx; color: #2f4b78; font-size: 24rpx; }
.transfer-track { height: 12rpx; background: #d9e0e9; border-radius: 12rpx; margin-top: 16rpx; overflow: hidden; }
.transfer-track.small { height: 8rpx; margin-top: 10rpx; }
.transfer-fill { height: 100%; background: #1f9d55; transition: width .15s; }
.transfer-row { margin-top: 24rpx; }
.transfer-detail { margin-top: 10rpx; color: #8b95a8; font-size: 22rpx; }
.preview-mask { position: fixed; top: 0; right: 0; bottom: 0; left: 0; z-index: 100; display: flex; align-items: center; justify-content: center; background: rgba(0,0,0,.85); padding: 28rpx; box-sizing: border-box; }
.preview-panel { width: 100%; }
.preview-heading { display: flex; align-items: center; justify-content: space-between; margin-bottom: 20rpx; color: #fff; font-size: 28rpx; }
.preview-close { margin: 0; padding: 8rpx 28rpx; line-height: 1.6; font-size: 26rpx; color: #fff; background: #344054; border-radius: 14rpx; }
.preview-close::after { border: 0; }
.preview-player { display: block; width: 100%; height: 68vh; background: #000; }
